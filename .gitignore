.env
# per-environment env files (.env.dev / .env.prod ...) — these hold live credentials.
.env.*
!.env.example
generated/
bin/
*.log
node_modules/
# local debug scripts (contain hardcoded API keys)
test-full.js
test-invalid.js
jobs.json
# design-feedback ledger: runtime state, same as jobs.json
feedback-ledger.json
# Scratch from running the review pipeline by hand. .apptok holds a live
# GitHub App installation token with write access to client repositories.
.apptok
.prnum
registry.json
reaudit.json
site-audits.json
server.out
ide-workspace/
email-requests.json
email-outbox.json

# GitHub App private keys — the repo is public; a key dropped here (e.g. a Render
# Secret File mirrored locally) must never be committable.
*.pem
*.key
# Render Secret Files are named after the variable they replace, so they carry no
# extension and *.pem would not catch them.
GH_APP_PRIVATE_KEY
GH_APP_PRIVATE_KEY.*
ted-subtasks.json

# Local test payloads / one-off scripts written while debugging a build. They hold
# a single client's onboarding data and never belong in the repo.
scratch-*.json
scratch-*.js
