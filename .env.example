# Copy to .env for local dev. On Render/Railway, set these in the platform's
# Environment dashboard instead (never commit real values).

# Google Stitch MCP key (AQ.-prefixed)
STITCH_API_KEY=

# Comma-separated Gemini API keys (rotation across free-tier quotas)
GEMINI_KEYS=

# GitHub token for push/PR/merge. Fine-grained PAT scoped to the WP repo with
# Contents: Read&Write + Pull requests: Read&Write. Locally optional (gh CLI
# login is used); REQUIRED when deployed.
GH_TOKEN=

# Password protecting all /api/* routes. Unset = no gate (local dev).
# REQUIRED on any public deployment — the API can push/merge to your repo.
ADMIN_PASSWORD=

# Shared secret the G99 platform sends in X-Webhook-Secret when POSTing
# /api/webhook/onboarding-submitted. Unset = webhook disabled (401s).
WEBHOOK_SECRET=

# Target WordPress Bedrock repo
WP_REPO=Growth99Infra/prodteam.gogroth.com

# Live site the pipeline watches for theme activation + runs the after-audit on
# WP_LIVE_URL=https://prodteam.gogroth.com/

# PageSpeed key for the build/mockup screenshot flow and the Perform PR
# PageSpeed audit. Optional for Perform PR — without it the API still answers,
# just rate-limited harder.
PSI_API_KEY=
# Browserless is required for Perform PR mobile screenshots.
BROWSERLESS_TOKEN=
# Shared US fleet by default. Private-fleet accounts must use their assigned URL.
BROWSERLESS_URL=https://production-sfo.browserless.io
BROWSERLESS_TIMEOUT_MS=60000
# Perform PR waits for an exact release marker instead of guessing deploy time.
PR_DEPLOY_TIMEOUT_MS=900000
PR_DEPLOY_POLL_MS=10000
# Small settling delay after the marker is live, for runtime/CDN consistency.
PR_DEPLOY_WAIT_MS=5000
# Optional overrides
# GEMINI_MODEL=gemini-flash-lite-latest
# PORT=8793

# Slack incoming-webhook for job notifications (optional)
SLACK_WEBHOOK_URL=
# Re-audit the live site every N hours (0 = off)
REAUDIT_HOURS=0

# Shared secret for the email → website change hook
# (POST /api/webhook/email-change). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Must match the SECRET in the Gmail Apps Script. Falls back to WEBHOOK_SECRET.
EMAIL_WEBHOOK_SECRET=
# Who may trigger a change by email — comma-separated domains and/or addresses.
# Default when unset: growth99.com
EMAIL_ALLOWED_SENDERS=growth99.com

# TED — accepted email requests are logged as a comment on the beta site
# revisions task. Unset TED_API_TOKEN = off; nothing else in the email flow
# changes. Mint a READ_WRITE token at TED ▸ Settings ▸ API Tokens (use a service
# account if you have one — comments are attributed to the token's owner).
TED_API_TOKEN=
# Optional overrides
# TED_BASE=https://ted.growth99.com
# Fallback task, used only when a per-client subtask could not be created.
# NOTE: this is one specific client's task, so a fallback files the request on
# the wrong client's board. Watch the logs for "falling back to task".
# TED_REVISIONS_TASK_ID=9078
# Each emailed change gets its own subtask under that client's revision-cycle
# task, and the outcome comment goes back onto the same subtask. off = the old
# behaviour, everything on TED_REVISIONS_TASK_ID.
# TED_SUBTASKS=on
# How the parent is found: template key, not title or id (both vary per client).
# TED_PARENT_KEY=beta_site.revision_cycle
# Optional secret for POST /api/webhook/ted-subtask, which turns a hand-made
# subtask under that parent into the same edit job an email starts.
# Unset = no secret, matching the other TED webhooks.
TED_SUBTASK_WEBHOOK_SECRET=
# The tool also polls for subtasks the webhook never delivered — TED's subtask
# trigger does not fire for every kind of subtask, and a webhook that never
# arrives looks exactly like one that was never sent. 0 = webhook only.
# TED_SUBTASK_POLL_MS=180000
# How the token is presented: bearer (default) or x-api-key.
# TED_AUTH_HEADER=bearer

# --- Content Review link, posted into TED ---------------------------------
# POST /api/webhook/ted-content-review. When the upstream content task closes,
# the tool mints a Content Review link for that client's beta site and posts it
# as a comment on the content-approval task — no subtask.
#
# OPTIONAL, like the other TED webhooks: checked when set, skipped when not.
# Worth setting, but not load-bearing — the minted link is never in the HTTP
# response, only in the TED comment, so an unauthenticated caller cannot come
# away holding one.
# Set the same value in TED's webhook config. Its Secret Auth tab sends
# X-TED-Webhook-Secret; the endpoint also accepts X-Webhook-Secret or a Bearer
# token, so a header added by hand instead works too.
TED_REVIEW_WEBHOOK_SECRET=
# Which task closing triggers it, and which task the link is posted on.
# TED_REVIEW_TRIGGER_KEY=content.create
# TED_REVIEW_TARGET_KEY=content.approval
# How long that link stays usable. Far longer than REVIEW_TTL_MIN because this
# one waits in a task until someone works it, rather than being handed over now.
# TED_REVIEW_TTL_MIN=10080
# Posts pre-release reports as the AI agent rather than as a person, via
# /api/tasks/<id>/comments/ai. Falls back to TED_API_TOKEN when unset, which
# posts under whoever owns that token instead.
TED_AI_API_KEY=
# When a change goes live, TED also gets a screenshot of the page. The wait is
# there because the deploy lands a moment after the merge — capturing straight
# away would show the old page. Set TED_SCREENSHOTS=off to keep the outcome
# comments but drop the images.
# TED_SHOT_DELAY_MS=60000
# TED_SCREENSHOTS=on
# Capture width. 1400 is ~110KB (~150KB once TED inlines it as base64); the
# ceiling is far higher, but going much wider buys little and costs a lot.
# TED_SHOT_WIDTH=1400

# ---- Pre-release trigger (POST /api/webhook/pre-release) --------------------
# The webhook TED fires when a pre-release task is triggered. The run creates one
# subtask per line of the pre-release QA checklist under that task, audits the
# built site, applies the fixes whose answer is computable, and posts each check's
# own findings/fixes as a comment on its own subtask. The parent task keeps a
# short index of the verdicts.
#
# Shared secret. Unset = no check, which is how this currently runs: TED's Secret
# Auth tab caused delivery failures on the content-review hook, and a webhook that
# never arrives is worse than one that is unauthenticated. Weigh that against what
# this endpoint does — every other TED hook only reads and comments, this one
# clones a client repository and opens a pull request.
#
# When it IS set, any of these carry it, so whichever TED tab was filled in works:
# X-TED-Webhook-Secret (Secret Auth tab), X-Webhook-Secret, X-TED-Secret, or a
# Bearer token. Reading only one of them is how a secret silently 401s every
# delivery.
PRE_RELEASE_WEBHOOK_SECRET=
# The four below are OVERRIDES, not setup. Their defaults are the behaviour we
# actually want, so a fresh deployment needs none of them set — commented out here
# on purpose. Reach for one only when a deployment genuinely wants to differ.
#
# Which task template keys start a run. Comma-separated, "*" for any.
# TED_PERFORM_PR_KEY=release.pre_dev,beta_site.release_approval
# Which status of the trigger task fires it. Blank = any status, which means a run
# starts when somebody merely picks the task up.
# TED_PERFORM_PR_STATUS=Completed
# Repeat triggers for the same task inside this window are ignored. TED can fire
# on any edit to a task — including the edits this run's own comments cause — and
# every firing would otherwise clone a repo and open a pull request.
# TED_PERFORM_PR_COOLDOWN_MIN=30
# Whether a triggered run waits for a human before merging. Off by default: TED
# only advances once the pre-release task completes, and that cannot happen while
# the run is parked at a gate, so the gate stalls the chain it belongs to. Turn it
# on where somebody really is watching for the pull request.
# TED_PERFORM_PR_APPROVAL=off

# Microlink key for screenshots (TED outcome comments + the CRO audit).
# OPTIONAL and paid — microlink's keyless tier is 25/day counted against the
# CALLING IP, which a shared host burns through on other tenants. Without a key
# captures fall back to WordPress mShots, which needs no key and has no quota
# but renders asynchronously (a few seconds slower). Set this only if you buy a
# microlink plan: https://microlink.io/
MICROLINK_API_KEY=

# Ollama Cloud — an optional second provider, offered ONLY in the "Edit with AI"
# chat. Builds, CRO audits, enrichment and the email matcher always use Gemini.
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# ---- GitHub App (preferred over GH_TOKEN) ----------------------------------
# The g99-gitops App is installed on the org, so pushes keep working when a person
# leaves, and its tokens expire after 60 minutes instead of never. The tool checks at
# startup whether the App can also open PRs and read CI checks; if not, it falls back
# to GH_TOKEN and logs exactly which permissions are missing.
#
# Required App permissions: Contents (RW), Pull requests (RW), Checks (RO),
# Commit statuses (RO), Metadata (RO). Workflows (RW) only if PRs touch .github/workflows.
#
# GH_APP_PRIVATE_KEY must be the .pem contents on ONE line with literal \n escapes —
# the .env loader matches KEY=VALUE per line, so a multi-line value silently truncates
# to '-----BEGIN RSA PRIVATE KEY-----'.
GH_APP_ID=
GH_APP_CLIENT_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY=
